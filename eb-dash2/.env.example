# ─── Supabase (obrigatórias) ────────────────────────────────────
# Encontre em: app.supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# ─── GoHighLevel (opcional) ─────────────────────────────────────
# Location ID usado para montar links "Abrir no GHL" na UI.
# Sem esta variável, os links de contato GHL ficam ocultos.
VITE_GHL_LOCATION_ID=
