# Variáveis de ambiente para Edge Function notion-creatives-sync
# Configurar no Supabase Dashboard: Project Settings → Edge Functions → Environment Variables

# Notion API
# Criar integração em: https://www.notion.so/profile/integrations
# Capability necessária: Read content
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database ID de Criativos Pagos (único database)
# Encontrar na URL do database: https://www.notion.so/workspace/{DATABASE_ID}?v=...
NOTION_DATABASE_ID_PAID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Database IDs de Criativos Orgânicos (múltiplos databases separados por vírgula)
# Exemplo: id1,id2,id3
NOTION_DATABASE_ID_ORGANIC=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx,yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# Supabase (já configurado automaticamente)
# SUPABASE_URL=https://[PROJECT_ID].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<chave_de_servico>
