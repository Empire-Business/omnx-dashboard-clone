# ============================================
# Template de variáveis de ambiente para novo cliente Empire
# ============================================
# Preencha todos os valores <preencher> e importe no Vercel do projeto do cliente.
# NUNCA commite um arquivo .env com valores reais.
# Este arquivo é um template com placeholders e pode ser versionado.
# ============================================

# --------------------------------------------
# SUPABASE — projeto isolado do cliente
# --------------------------------------------
# URL do projeto Supabase (ex: https://abc123.supabase.co)
VITE_SUPABASE_URL=<preencher>

# Anon Key do projeto Supabase (Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=<preencher>

# --------------------------------------------
# GHL — conta do cliente (usado para links e fallbacks no frontend)
# --------------------------------------------
# Location ID da conta GoHighLevel do cliente
VITE_GHL_LOCATION_ID=<preencher>

# --------------------------------------------
# Opcionais / futuras integrações
# --------------------------------------------
# Sentry (opcional)
# VITE_SENTRY_DSN=<preencher>

# Google Analytics (opcional)
# VITE_GA_ID=<preencher>
